#!/bin/sh
if [ "${USAGE_TEST_INTERRUPT:-}" = before-commit-journal ] && [ "${2##*/}" = commit ]; then
  kill -TERM "$PPID"
  exit 1
fi
if [ "${USAGE_TEST_INTERRUPT:-}" = before-preview ] && [ "${1##*/}" = candidate ]; then
  kill -TERM "$PPID"
  exit 1
fi
if [ "${USAGE_TEST_INTERRUPT:-}" = after-preview ] && [ "${1##*/}" = candidate ]; then
  /bin/mv "$@" || exit $?
  kill -TERM "$PPID"
  exit 0
fi
exec /bin/mv "$@"
